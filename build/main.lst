 102:Core/Src/main.c ****   /* Infinite loop */
 103:Core/Src/main.c ****   /* USER CODE BEGIN WHILE */
 104:Core/Src/main.c ****   while (1)
 105:Core/Src/main.c ****   {
 106:Core/Src/main.c ****     /* USER CODE END WHILE */
 107:Core/Src/main.c **** 
 108:Core/Src/main.c ****     /* USER CODE BEGIN 3 */
 109:Core/Src/main.c ****     /*
 110:Core/Src/main.c ****     Calculo do circuito divisor de tensão para o LDR:
 111:Core/Src/main.c ****      RLDR varia de ~473 Ohms (luz) a ~180kOhms (escuro)
 112:Core/Src/main.c ****      R1= sqrt(RLDR_min*RLDR_max) = 9.23kOhms
 113:Core/Src/main.c ****      R1 = 10k Ohms (no calculo 9.23kOhms)
 114:Core/Src/main.c ****      R_th_max = R1xRLDR/(R1+RLDR) = 8662 Ohms
 115:Core/Src/main.c ****      V_th_max = Vcc*R_th_max/(R_th_max+R1) = 3.14V  (considerando Vcc = 3.3V)
 116:Core/Src/main.c ****      R_th_min = R1xRHDR/(R1+RHDR) = 550 Ohms
 117:Core/Src/main.c ****      V_th_min = Vcc*R_th_min/(R_th_min+R1) = 0.16V
 118:Core/Src/main.c ****      adc_min = 0.16*4095/3.3 = 199
 119:Core/Src/main.c ****      adc_max = 3.14*4095/3.3 = 3894
 120:Core/Src/main.c ****     */
 121:Core/Src/main.c **** 
 122:Core/Src/main.c ****     HAL_ADC_Start(&hadc1);
 123:Core/Src/main.c ****     if (HAL_ADC_PollForConversion(&hadc1, 100) == HAL_OK)
 124:Core/Src/main.c ****     {
 125:Core/Src/main.c ****       valorADC = HAL_ADC_GetValue(&hadc1); // variavel que o professor pode colocar Watch durante d
 126:Core/Src/main.c ****     }
 127:Core/Src/main.c ****     HAL_ADC_Stop(&hadc1);
 128:Core/Src/main.c ****     //controle de overflow
 129:Core/Src/main.c ****     if (valorADC <= adc_min)
 130:Core/Src/main.c ****     {
 131:Core/Src/main.c ****       nivelLed = 0;
 132:Core/Src/main.c ****     }
 133:Core/Src/main.c ****     else if (valorADC >= adc_max)
 134:Core/Src/main.c ****     {
 135:Core/Src/main.c ****       nivelLed = 5;
 136:Core/Src/main.c ****     } //se nao ocorrer overflow, faz o mapeamento
 137:Core/Src/main.c ****     else
 138:Core/Src/main.c ****     {
 139:Core/Src/main.c ****       // Mapeia linearmente a faixa de ADC para o número de LEDs (1 a 4)
 140:Core/Src/main.c ****       nivelLed = 1 + (4 * (valorADC - adc_min)) / (adc_max - adc_min);    //adcmax - adcmin = range
 141:Core/Src/main.c ****     }
 142:Core/Src/main.c ****     nivelLed = valorADC/750;
 143:Core/Src/main.c ****     nivelLed = (1<<nivelLed) - 1;
 144:Core/Src/main.c ****     HAL_GPIO_WritePin(GPIOA, ((~nivelLed)&(0x1F))<<3,0);
 145:Core/Src/main.c ****     HAL_GPIO_WritePin(GPIOA, nivelLed<<3,1);
