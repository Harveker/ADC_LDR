 106:Core/Src/main.c ****   MX_TIM3_Init();
 107:Core/Src/main.c ****   /* USER CODE BEGIN 2 */
 108:Core/Src/main.c ****   HAL_TIM_PWM_Start(&htim3, TIM_CHANNEL_1);
 109:Core/Src/main.c ****   /* USER CODE END 2 */
 110:Core/Src/main.c **** 
 111:Core/Src/main.c ****   /* Infinite loop */
 112:Core/Src/main.c ****   /* USER CODE BEGIN WHILE */
 113:Core/Src/main.c ****   while (1)
 114:Core/Src/main.c ****   {
 115:Core/Src/main.c ****     /* USER CODE END WHILE */
 116:Core/Src/main.c **** 
 117:Core/Src/main.c ****     /* USER CODE BEGIN 3 */
 118:Core/Src/main.c ****     /*
 119:Core/Src/main.c ****     Calculo do circuito divisor de tensão para o LDR:
 120:Core/Src/main.c ****      RLDR varia de ~473 Ohms (luz) a ~180kOhms (escuro)
 121:Core/Src/main.c ****      R1= sqrt(RLDR_min*RLDR_max) = 9.23kOhms
 122:Core/Src/main.c ****      R1 = 10k Ohms (no calculo 9.23kOhms)
 123:Core/Src/main.c ****      R_th_max = R1xRLDR/(R1+RLDR) = 8662 Ohms
 124:Core/Src/main.c ****      V_th_max = Vcc*R_th_max/(R_th_max+R1) = 3.14V  (considerando Vcc = 3.3V)
 125:Core/Src/main.c ****      R_th_min = R1xRHDR/(R1+RHDR) = 550 Ohms
 126:Core/Src/main.c ****      V_th_min = Vcc*R_th_min/(R_th_min+R1) = 0.16V
 127:Core/Src/main.c ****      adc_min = 0.16*4095/3.3 = 199
 128:Core/Src/main.c ****      adc_max = 3.14*4095/3.3 = 3894
 129:Core/Src/main.c ****     */
 130:Core/Src/main.c **** 
 131:Core/Src/main.c ****     HAL_ADC_Start(&hadc1);
 132:Core/Src/main.c ****     if (HAL_ADC_PollForConversion(&hadc1, 100) == HAL_OK)
 133:Core/Src/main.c ****     {
 134:Core/Src/main.c ****       valorADC = HAL_ADC_GetValue(&hadc1); // variavel que o professor pode colocar Watch durante d
 135:Core/Src/main.c ****     }
 136:Core/Src/main.c ****     HAL_ADC_Stop(&hadc1);
 137:Core/Src/main.c ****     // controle de overflow
 138:Core/Src/main.c ****     if (valorADC <= adc_min)
 139:Core/Src/main.c ****     {
 140:Core/Src/main.c ****       nivelLed = 0;
 141:Core/Src/main.c ****     }
 142:Core/Src/main.c ****     else if (valorADC >= adc_max)
 143:Core/Src/main.c ****     {
 144:Core/Src/main.c ****       nivelLed = 5;
 145:Core/Src/main.c ****     } // se nao ocorrer overflow, faz o mapeamento
ARM GAS  C:\Users\HOTEL-~1\AppData\Local\Temp\ccbKaWna.s 			page 4


 146:Core/Src/main.c ****     else
 147:Core/Src/main.c ****     {
 148:Core/Src/main.c ****       // Mapeia linearmente a faixa de ADC para o número de LEDs (1 a 4)
 149:Core/Src/main.c ****       nivelLed = 1 + (4 * (valorADC - adc_min)) / (adc_max - adc_min); // adcmax - adcmin = range v
 150:Core/Src/main.c ****     }
 151:Core/Src/main.c ****     nivelLed = valorADC / 750;
 152:Core/Src/main.c ****     nivelLed = (1 << nivelLed) - 1;
 153:Core/Src/main.c ****     HAL_GPIO_WritePin(GPIOA, ((~nivelLed) & (0x1F)) << 3, 0);
 154:Core/Src/main.c ****     HAL_GPIO_WritePin(GPIOA, nivelLed << 3, 1);
 155:Core/Src/main.c **** 
 156:Core/Src/main.c ****     // Aciona os LEDs de acordo com o nível calculado
 157:Core/Src/main.c ****     // HAL_GPIO_WritePin(GPIOA, GPIO_PIN_3, (nivelLed <= 1) ? GPIO_PIN_RESET : GPIO_PIN_SET); // if
 158:Core/Src/main.c ****     // HAL_GPIO_WritePin(GPIOA, GPIO_PIN_3, (nivelLed >= 1) ? GPIO_PIN_SET : GPIO_PIN_RESET);
 159:Core/Src/main.c ****     // HAL_GPIO_WritePin(GPIOA, GPIO_PIN_4, (nivelLed >= 2) ? GPIO_PIN_SET : GPIO_PIN_RESET);
 160:Core/Src/main.c ****     // HAL_GPIO_WritePin(GPIOA, GPIO_PIN_5, (nivelLed >= 3) ? GPIO_PIN_SET : GPIO_PIN_RESET);
 161:Core/Src/main.c ****     // HAL_GPIO_WritePin(GPIOA, GPIO_PIN_6, (nivelLed >= 4) ? GPIO_PIN_SET : GPIO_PIN_RESET);
 162:Core/Src/main.c ****     // HAL_GPIO_WritePin(GPIOA, GPIO_PIN_7, (nivelLed >= 5) ? GPIO_PIN_SET : GPIO_PIN_RESET);
 163:Core/Src/main.c **** 
 164:Core/Src/main.c ****     // Pequeno delay para estabilidade da leitura
 165:Core/Src/main.c ****     HAL_Delay(30);
 166:Core/Src/main.c ****     // ongoing----------------------------------------------------------------------
 167:Core/Src/main.c ****     if (gUSBRxBuffer[0] != 0)
 168:Core/Src/main.c ****     {
 169:Core/Src/main.c ****       if ((gUSBRxBuffer[0] == 80 ) || (gUSBRxBuffer[0] == 37))
 170:Core/Src/main.c ****       {
 171:Core/Src/main.c ****         sprintf(buffer, "O percentual do fundo de escala do A/D eh de %lu.%lu% %%,apresentando uma 
 172:Core/Src/main.c ****         CDC_Transmit_FS(buffer, strlen(buffer));
 173:Core/Src/main.c ****         gUSBRxBuffer[0] = 0;
 174:Core/Src/main.c ****       }
 175:Core/Src/main.c ****       else if (gUSBRxBuffer[0] == 115)  // s para subir
 176:Core/Src/main.c ****       {
 177:Core/Src/main.c ****         if (htim3.Instance->CCR1 < MAX_PWM - STEP_PWM)
 178:Core/Src/main.c ****         {
 179:Core/Src/main.c ****           sprintf(buffer, "Duty Cycle atual: %lu%%\n", htim3.Instance->CCR1);
 180:Core/Src/main.c ****           CDC_Transmit_FS(buffer, strlen(buffer));
 181:Core/Src/main.c ****           htim3.Instance->CCR1 += STEP_PWM;
 182:Core/Src/main.c ****           gUSBRxBuffer[0] = 0;
 183:Core/Src/main.c ****         }
 184:Core/Src/main.c ****         else
 185:Core/Src/main.c ****         {
 186:Core/Src/main.c ****           sprintf(buffer, "Duty Cycle atual: 100%%\n");
 187:Core/Src/main.c ****           CDC_Transmit_FS(buffer, strlen(buffer));
 188:Core/Src/main.c ****           htim3.Instance->CCR1 = MAX_PWM;
 189:Core/Src/main.c ****           gUSBRxBuffer[0] = 0;
 190:Core/Src/main.c ****         }
 191:Core/Src/main.c ****       }
 192:Core/Src/main.c ****       else if (gUSBRxBuffer[0] == 100)  // d para descer
 193:Core/Src/main.c ****       {
 194:Core/Src/main.c ****         if (htim3.Instance->CCR1 > MIN_PWM + STEP_PWM)
 195:Core/Src/main.c ****         {
 196:Core/Src/main.c ****           sprintf(buffer, "Duty Cycle atual: %lu%%\n", htim3.Instance->CCR1);
 197:Core/Src/main.c ****           CDC_Transmit_FS(buffer, strlen(buffer));
 198:Core/Src/main.c ****           htim3.Instance->CCR1 -= STEP_PWM;
 199:Core/Src/main.c ****           gUSBRxBuffer[0] = 0;
 200:Core/Src/main.c ****         }
 201:Core/Src/main.c ****         else
 202:Core/Src/main.c ****         {
ARM GAS  C:\Users\HOTEL-~1\AppData\Local\Temp\ccbKaWna.s 			page 5


 203:Core/Src/main.c ****           sprintf(buffer, "Duty Cycle atual: 0%%\n");
 204:Core/Src/main.c ****           CDC_Transmit_FS(buffer, strlen(buffer));
 205:Core/Src/main.c ****           htim3.Instance->CCR1 = MIN_PWM;
 206:Core/Src/main.c ****           gUSBRxBuffer[0] = 0;
 207:Core/Src/main.c ****         }
 208:Core/Src/main.c ****       }
 209:Core/Src/main.c ****     }
 210:Core/Src/main.c ****     HAL_Delay(30);
 211:Core/Src/main.c ****   }
 212:Core/Src/main.c ****   /* USER CODE END 3 */
 213:Core/Src/main.c **** }
