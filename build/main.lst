 100:Core/Src/main.c **** 
 101:Core/Src/main.c ****   /* USER CODE END 2 */
 102:Core/Src/main.c **** 
 103:Core/Src/main.c ****   /* Infinite loop */
 104:Core/Src/main.c ****   /* USER CODE BEGIN WHILE */
 105:Core/Src/main.c ****   while (1)
 106:Core/Src/main.c ****   {
 107:Core/Src/main.c ****     /* USER CODE END WHILE */
 108:Core/Src/main.c **** 
 109:Core/Src/main.c ****     /* USER CODE BEGIN 3 */
 110:Core/Src/main.c ****     /*
 111:Core/Src/main.c ****     Calculo do circuito divisor de tensão para o LDR:
 112:Core/Src/main.c ****      RLDR varia de ~473 Ohms (luz) a ~180kOhms (escuro)
 113:Core/Src/main.c ****      R1= sqrt(RLDR_min*RLDR_max) = 9.23kOhms
 114:Core/Src/main.c ****      R1 = 10k Ohms (no calculo 9.23kOhms)
 115:Core/Src/main.c ****      R_th_max = R1xRLDR/(R1+RLDR) = 8662 Ohms
 116:Core/Src/main.c ****      V_th_max = Vcc*R_th_max/(R_th_max+R2) = 3.14V  (considerando Vcc = 3.3V)
 117:Core/Src/main.c ****      R_th_min = R1xRHDR/(R1+RHDR) = 550 Ohms
 118:Core/Src/main.c ****      V_th_min = Vcc*R_th_min/(R_th_min+R2) = 0.16V
 119:Core/Src/main.c ****      adc_min = 0.16*4095/3.3 = 199
 120:Core/Src/main.c ****      adc_max = 3.14*4095/3.3 = 3894
 121:Core/Src/main.c ****     */
 122:Core/Src/main.c **** 
 123:Core/Src/main.c ****     HAL_ADC_Start(&hadc1);
 124:Core/Src/main.c ****     if (HAL_ADC_PollForConversion(&hadc1, 100) == HAL_OK)
 125:Core/Src/main.c ****     {
 126:Core/Src/main.c ****       valorADC = HAL_ADC_GetValue(&hadc1); // variavel que o professor pode colocar Watch durante d
 127:Core/Src/main.c ****     }
 128:Core/Src/main.c ****     HAL_ADC_Stop(&hadc1);
 129:Core/Src/main.c **** 
 130:Core/Src/main.c ****     if (valorADC <= adc_min)
 131:Core/Src/main.c ****     {
 132:Core/Src/main.c ****       nivelLed = 0;
 133:Core/Src/main.c ****     }
 134:Core/Src/main.c ****     else if (valorADC >= adc_max)
 135:Core/Src/main.c ****     {
 136:Core/Src/main.c ****       nivelLed = 5;
 137:Core/Src/main.c ****     }
 138:Core/Src/main.c ****     else
 139:Core/Src/main.c ****     {
 140:Core/Src/main.c ****       // Mapeia linearmente a faixa de ADC para o número de LEDs (1 a 4)
 141:Core/Src/main.c ****       nivelLed = 1 + (4 * (valorADC - adc_min)) / (adc_max - adc_min);
 142:Core/Src/main.c ****     }
 143:Core/Src/main.c **** 
 144:Core/Src/main.c ****     // Aciona os LEDs de acordo com o nível calculado
 145:Core/Src/main.c ****     HAL_GPIO_WritePin(GPIOA, GPIO_PIN_3, (nivelLed >= 1) ? GPIO_PIN_SET : GPIO_PIN_RESET); // if el
ARM GAS  C:\Users\HOTEL-~1\AppData\Local\Temp\ccUvxZtG.s 			page 4


 146:Core/Src/main.c ****     HAL_GPIO_WritePin(GPIOA, GPIO_PIN_4, (nivelLed >= 2) ? GPIO_PIN_SET : GPIO_PIN_RESET);
 147:Core/Src/main.c ****     HAL_GPIO_WritePin(GPIOA, GPIO_PIN_5, (nivelLed >= 3) ? GPIO_PIN_SET : GPIO_PIN_RESET);
 148:Core/Src/main.c ****     HAL_GPIO_WritePin(GPIOA, GPIO_PIN_6, (nivelLed >= 4) ? GPIO_PIN_SET : GPIO_PIN_RESET);
 149:Core/Src/main.c ****     HAL_GPIO_WritePin(GPIOA, GPIO_PIN_7, (nivelLed >= 5) ? GPIO_PIN_SET : GPIO_PIN_RESET);
 150:Core/Src/main.c ****     /*
